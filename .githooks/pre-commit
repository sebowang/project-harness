#!/bin/sh
set -eu

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

if command -v pwsh >/dev/null 2>&1; then
  powershell_command=pwsh
elif command -v powershell >/dev/null 2>&1; then
  powershell_command=powershell
else
  echo "Project Harness pre-commit: pwsh or powershell was not found." >&2
  exit 1
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -File scripts/check-artifact-catalog.ps1 -Staged
